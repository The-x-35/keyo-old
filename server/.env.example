PORT=8787
# Shared secret the keyboard sends as x-keyo-token (leave empty for local only)
KEYO_TOKEN=

# Bitrefill: create at bitrefill.com/account/developers. Never commit it.
BITREFILL_API_KEY=
# Balance sub-account the MCP charges (USD, EUR or BTC)
BITREFILL_BALANCE_CURRENCY=USD
# Guardrails in rupees: over these, the purchase waits for Face ID approval in the app
CAP_PER_PURCHASE_INR=500
CAP_PER_DAY_INR=1000

# AI suggestions for free-form text (rules work without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Your addresses: requests pay you here, swaps land here
USER_ZEC_ADDRESS=
# NEAR Intents refunds ZEC to a transparent address (t1...)
USER_ZEC_REFUND_ADDRESS=
USER_SOL_ADDRESS=
USER_ETH_ADDRESS=
# Optional 1Click JWT (lower fees)
ONECLICK_JWT=

# Server wallet (zcash-devtool). Without these the keyboard uses Zodl.
ZEC_DEVTOOL_BIN=
ZEC_WALLET_DIR=
ZEC_TEST_WALLET_DIR=
# main or test
AEGIS_NETWORK=main
ZEC_IDENTITY_FILE=
ZEC_LIGHTWALLETD=zecrocks
